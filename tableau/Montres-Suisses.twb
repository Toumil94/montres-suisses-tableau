          <datasource-dependencies datasource="federated.db591f0d94dd5d62eab9577b"><column caption="Pays" datatype="string" name="[pays]" role="dimension" type="nominal" /><column caption="Année" datatype="integer" name="[annee]" role="dimension" type="ordinal" /><column caption="Valeur (CHF)" datatype="real" name="[valeur_chf]" role="measure" type="quantitative" /><column caption="Exportations (année)" datatype="real" default-format="n#,##0" name="[Calc_ValeurAnnee]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [valeur_chf] END)" /></column><column caption="Exportations (Mrd CHF)" datatype="real" default-format="n#,##0.00" name="[Calc_ValeurMrd]" role="measure" type="quantitative"><calculation class='tableau' formula="[Calc_ValeurAnnee] / 1000000000" /></column><column caption="Matière de la boîte" datatype="string" name="[matiere]" role="dimension" type="nominal" /><column caption="Pièces" datatype="integer" name="[pieces]" role="measure" type="quantitative" /><column caption="Pièces (année)" datatype="real" default-format="n#,##0" name="[Calc_PiecesAnnee]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [pieces] END)" /></column><column caption="Prix moyen à l'export (CHF par pièce)" datatype="real" default-format="n#,##0" name="[Calc_PrixMoyen]" role="measure" type="quantitative"><calculation class='tableau' formula="[Calc_ValeurAnnee] / [Calc_PiecesAnnee]" /></column><column caption="Code SH" datatype="string" name="[code_sh]" role="dimension" type="nominal" /><column caption="Segment" datatype="string" name="[Calc_Segment]" role="dimension" type="nominal"><calculation class='tableau' formula='IF ([code_sh] = "910121" OR [code_sh] = "910221") THEN "Mécanique automatique" ELSE "Autres montres" END' /></column><column caption="Rang du pays dans l'année" datatype="integer" name="[rang_pays]" role="measure" type="quantitative" /><column caption="Top 15 des marchés" datatype="boolean" name="[Calc_Top15]" role="dimension" type="nominal"><calculation class='tableau' formula="{FIXED [pays] : MIN(IF [annee] = [Parameters].[Parameter 1] THEN [rang_pays] END)} &lt;= 15" /></column><column-instance column="[pays]" derivation="None" name="[none:pays:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_ValeurMrd]" derivation="User" name="[usr:Calc_ValeurMrd:qk]" pivot='key' type="quantitative" /><column-instance column="[matiere]" derivation="None" name="[none:matiere:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_PrixMoyen]" derivation="User" name="[usr:Calc_PrixMoyen:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_Segment]" derivation="None" name="[none:Calc_Segment:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_Top15]" derivation="None" name="[none:Calc_Top15:nk]" pivot='key' type="nominal" /></datasource-dependencies>
