née)" datatype="real" default-format="n#,##0" name="[Calc_PiecesAnnee]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [pieces] END)" /></column><column caption="Prix moyen à l'export (CHF par pièce)" datatype="real" default-format="n#,##0" name="[Calc_PrixMoyen]" role="measure" type="quantitative"><calculation class='tableau' formula="[Calc_ValeurAnnee] / [Calc_PiecesAnnee]" /></column><column caption="Rang du pays dans l'année" datatype="integer" name="[rang_pays]" role="measure" type="quantitative" /><column caption="Top 15 des marchés" datatype="boolean" name="[Calc_Top15]" role="dimension" type="nominal"><calculation class='tableau' formula="{FIXED [pays] : MIN(IF [annee] = [Parameters].[Parameter 1] THEN [rang_pays] END)} &lt;= 15" /></column><column-instance column="[pays]" derivation="None" name="[none:pays:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_ValeurMrd]" derivation="User" name="[usr:Calc_ValeurMrd:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_Evolution]" derivation="User" name="[usr:Calc_Evolution:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_PartMarche]" derivation="User" name="[usr:Calc_PartMarche:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_PrixMoyen]" derivation="User" name="[usr:Calc_PrixMoyen:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_Top15]" derivation="None" name="[none:Calc_Top15:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_ValeurAnnee]" derivation="User" name="[usr:Calc_ValeurAnnee:qk]" pivot='key' type="quantitative" /></datasource-dependencies>
