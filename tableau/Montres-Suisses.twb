      <column caption="Année" datatype="integer" name="[annee]" role="dimension" type="ordinal" />
      <column caption="Pays" datatype="string" name="[pays]" role="dimension" type="nominal" />
      <column caption="Pays (carte)" datatype="string" name="[pays_en]" role="dimension" semantic-role="[Country].[Name]" type="nominal" />
      <column caption="Code ISO" datatype="string" name="[iso3]" role="dimension" type="nominal" />
      <column caption="Région" datatype="string" name="[region]" role="dimension" type="nominal" />
      <column caption="Code SH" datatype="string" name="[code_sh]" role="dimension" type="nominal" />
      <column caption="Catégorie" datatype="string" name="[categorie]" role="dimension" type="nominal" />
      <column caption="Matière de la boîte" datatype="string" name="[matiere]" role="dimension" type="nominal" />
      <column caption="Mouvement" datatype="string" name="[mouvement]" role="dimension" type="nominal" />
      <column caption="Valeur (CHF)" datatype="real" name="[valeur_chf]" role="measure" type="quantitative" />
      <column caption="Valeur (USD)" datatype="real" name="[valeur_usd]" role="measure" type="quantitative" />
      <column caption="Pièces" datatype="integer" name="[pieces]" role="measure" type="quantitative" />
      <column caption="Rang du pays dans l'année" datatype="integer" name="[rang_pays]" role="measure" type="quantitative" />
      <column caption="Exportations (année)" datatype="real" default-format="n#,##0" name="[Calc_ValeurAnnee]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [valeur_chf] END)" />
      </column>
      <column caption="Exportations (Mrd CHF)" datatype="real" default-format="n#,##0.00" name="[Calc_ValeurMrd]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurAnnee] / 1000000000" />
      </column>
      <column caption="Exportations (année précédente)" datatype="real" default-format="n#,##0" name="[Calc_ValeurN1]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] - 1 THEN [valeur_chf] END)" />
      </column>
      <column caption="Évolution vs N-1" datatype="real" default-format="p0.0%" name="[Calc_Evolution]" role="measure" type="quantitative">
        <calculation class='tableau' formula="([Calc_ValeurAnnee] - [Calc_ValeurN1]) / [Calc_ValeurN1]" />
      </column>
      <column caption="Exportations 2019" datatype="real" default-format="n#,##0" name="[Calc_Valeur2019]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM(IF [annee] = 2019 THEN [valeur_chf] END)" />
      </column>
      <column caption="Niveau vs 2019" datatype="real" default-format="p0%" name="[Calc_Niveau2019]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurAnnee] / [Calc_Valeur2019]" />
      </column>
      <column caption="Pièces (année)" datatype="real" default-format="n#,##0" name="[Calc_PiecesAnnee]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [pieces] END)" />
      </column>
      <column caption="Pièces (année précédente)" datatype="real" default-format="n#,##0" name="[Calc_PiecesN1]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM(IF [annee] = [Parameters].[Parameter 1] - 1 THEN [pieces] END)" />
      </column>
      <column caption="Prix moyen à l'export (CHF par pièce)" datatype="real" default-format="n#,##0" name="[Calc_PrixMoyen]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurAnnee] / [Calc_PiecesAnnee]" />
      </column>
      <column caption="Prix moyen N-1" datatype="real" default-format="n#,##0" name="[Calc_PrixMoyenN1]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurN1] / [Calc_PiecesN1]" />
      </column>
      <column caption="Évolution du prix moyen" datatype="real" default-format="p0.0%" name="[Calc_PrixEvolution]" role="measure" type="quantitative">
        <calculation class='tableau' formula="([Calc_PrixMoyen] - [Calc_PrixMoyenN1]) / [Calc_PrixMoyenN1]" />
      </column>
      <column caption="Prix moyen (CHF par pièce)" datatype="real" default-format="n#,##0" name="[Calc_PrixMoyenTous]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([valeur_chf]) / SUM([pieces])" />
      </column>
      <column caption="Part des montres mécaniques (valeur)" datatype="real" default-format="p0.0%" name="[Calc_PartMeca]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] AND STARTSWITH([mouvement], "Mécanique") THEN [valeur_chf] END) / [Calc_ValeurAnnee]' />
      </column>
      <column caption="Part des boîtes en métal précieux (valeur)" datatype="real" default-format="p0.0%" name="[Calc_PartPrecieux]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] AND [matiere] = "Métal précieux" THEN [valeur_chf] END) / [Calc_ValeurAnnee]' />
      </column>
      <column caption="Total des exportations (année)" datatype="real" default-format="n#,##0" name="[Calc_TotalMonde]" role="measure" type="quantitative">
        <calculation class='tableau' formula="{FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [valeur_chf] END)}" />
      </column>
      <column caption="Part des exportations suisses" datatype="real" default-format="p0.0%" name="[Calc_PartMarche]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurAnnee] / MIN([Calc_TotalMonde])" />
      </column>
      <column caption="Top 15 des marchés" datatype="boolean" name="[Calc_Top15]" role="dimension" type="nominal">
        <calculation class='tableau' formula="{FIXED [pays] : MIN(IF [annee] = [Parameters].[Parameter 1] THEN [rang_pays] END)} &lt;= 15" />
      </column>
      <column caption="Contribution à la croissance (CHF)" datatype="real" default-format="n#,##0" name="[Calc_Contribution]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_ValeurAnnee] - [Calc_ValeurN1]" />
      </column>
      <column caption="Période" datatype="string" name="[Calc_Periode]" role="dimension" type="nominal">
        <calculation class='tableau' formula='IF [annee] = [Parameters].[Parameter 1] THEN "Année sélectionnée" ELSE "Autres années" END' />
      </column>
      <column caption="Exportations totales (Mrd CHF)" datatype="real" default-format="n#,##0.00" name="[Calc_ValeurToutesMrd]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([valeur_chf]) / 1000000000" />
      </column>
      <column caption="Segment" datatype="string" name="[Calc_Segment]" role="dimension" type="nominal">
        <calculation class='tableau' formula='IF ([code_sh] = "910121" OR [code_sh] = "910221") THEN "Mécanique automatique" ELSE "Autres montres" END' />
      </column>
      <column caption="Automatiques (Mrd CHF)" datatype="real" default-format="n#,##0.00" name="[Calc_LuxeValeur]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] AND ([code_sh] = "910121" OR [code_sh] = "910221") THEN [valeur_chf] END) / 1000000000' />
      </column>
      <column caption="Automatiques N-1 (Mrd CHF)" datatype="real" default-format="n#,##0.00" name="[Calc_LuxeValeurN1]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] - 1 AND ([code_sh] = "910121" OR [code_sh] = "910221") THEN [valeur_chf] END) / 1000000000' />
      </column>
      <column caption="Évolution des automatiques vs N-1" datatype="real" default-format="p0.0%" name="[Calc_LuxeEvolution]" role="measure" type="quantitative">
        <calculation class='tableau' formula="([Calc_LuxeValeur] - [Calc_LuxeValeurN1]) / [Calc_LuxeValeurN1]" />
      </column>
      <column caption="Automatiques exportées (pièces)" datatype="real" default-format="n#,##0" name="[Calc_LuxePieces]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] AND ([code_sh] = "910121" OR [code_sh] = "910221") THEN [pieces] END)' />
      </column>
      <column caption="Prix moyen d'une automatique (CHF)" datatype="real" default-format="n#,##0" name="[Calc_LuxePrix]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_LuxeValeur] * 1000000000 / [Calc_LuxePieces]" />
      </column>
      <column caption="Part des automatiques dans la valeur" datatype="real" default-format="p0.0%" name="[Calc_LuxePart]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_LuxeValeur] * 1000000000 / [Calc_ValeurAnnee]" />
      </column>
      <column caption="Part de l'or dans les automatiques" datatype="real" default-format="p0.0%" name="[Calc_LuxeOr]" role="measure" type="quantitative">
        <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] AND [code_sh] = "910121" THEN [valeur_chf] END) / ([Calc_LuxeValeur] * 1000000000)' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="KPI Valeur">
